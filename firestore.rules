rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function ownsUserDocument(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, create, update, delete: if ownsUserDocument(userId);

      match /weights/{entryId} {
        allow read, create, update, delete: if ownsUserDocument(userId);
      }

      match /workoutHistory/{workoutId} {
        allow read, create, update, delete: if ownsUserDocument(userId);
      }
    }
  }
}
